rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdminEmailValue(email) {
      return email is string
        && (email == 'l2xbrasil@gmail.com'
          || email == 'L2xbrasil@gmail.com'
          || email.matches('^[lL]2[xX][bB][rR][aA][sS][iI][lL]@[gG][mM][aA][iI][lL]\\.[cC][oO][mM]$'));
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && isBootstrappedAdminEmailValue(request.auth.token.email);
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validators
    function isValidProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSearchPreferences(sp) {
      return sp is map
        && sp.keys().hasAll(['window', 'includeLiveMatches', 'sortBy', 'favoriteLeagues'])
        && sp.keys().hasOnly(['window', 'includeLiveMatches', 'sortBy', 'favoriteLeagues'])
        && sp.window is string && sp.window.size() <= 20 && sp.window in ['today', '48h', 'week']
        && sp.includeLiveMatches is bool
        && sp.sortBy is string && sp.sortBy.size() <= 24 && sp.sortBy in ['time', 'league', 'odds_balance']
        && sp.favoriteLeagues is list && sp.favoriteLeagues.size() <= 12;
    }

    function isValidNotificationPreferences(np) {
      return np is map
        && np.keys().hasAll([
          'enabled',
          'browserPush',
          'notifyLiveGoals',
          'notifyBetResolved',
          'notifyDailySuperTip',
          'notifyKickoffMinutes',
          'soundEnabled'
        ])
        && np.keys().hasOnly([
          'enabled',
          'browserPush',
          'notifyLiveGoals',
          'notifyBetResolved',
          'notifyDailySuperTip',
          'notifyKickoffMinutes',
          'soundEnabled'
        ])
        && np.enabled is bool
        && np.browserPush is bool
        && np.notifyLiveGoals is bool
        && np.notifyBetResolved is bool
        && np.notifyDailySuperTip is bool
        && np.notifyKickoffMinutes is int && np.notifyKickoffMinutes in [0, 15, 30, 60]
        && np.soundEnabled is bool;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'theme',
          'championshipScope',
          'updateMode',
          'activeModules',
          'recentFormWeight',
          'homeAdvantageMultiplier',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'theme',
          'championshipScope',
          'updateMode',
          'activeModules',
          'recentFormWeight',
          'homeAdvantageMultiplier',
          'searchPreferences',
          'notifications',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.theme is string && data.theme.size() <= 10 && data.theme in ['light', 'dark']
        && data.championshipScope is string && data.championshipScope.size() <= 20 && data.championshipScope in ['brasil', 'principais', 'todos']
        && data.updateMode is string && data.updateMode.size() <= 20 && data.updateMode in ['auto', 'manual']
        && data.activeModules is map
        && data.activeModules.keys().hasAll([
          'lastFive',
          'headToHead',
          'standings',
          'poisson',
          'goalsAndBtts',
          'corners',
          'cards',
          'contextFactors'
        ])
        && data.activeModules.keys().hasOnly([
          'lastFive',
          'headToHead',
          'standings',
          'poisson',
          'goalsAndBtts',
          'corners',
          'cards',
          'contextFactors'
        ])
        && data.recentFormWeight is number && data.recentFormWeight >= 0.10 && data.recentFormWeight <= 0.65
        && data.homeAdvantageMultiplier is number && data.homeAdvantageMultiplier >= 0.90 && data.homeAdvantageMultiplier <= 1.40
        && (!('searchPreferences' in data) || isValidSearchPreferences(data.searchPreferences))
        && (!('notifications' in data) || isValidNotificationPreferences(data.notifications))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPredictionAnalysis(data, userId, analysisId) {
      return data.keys().hasAll([
          'ownerId',
          'id',
          'competition',
          'homeTeam',
          'awayTeam',
          'predictedHomePct',
          'predictedDrawPct',
          'predictedAwayPct',
          'expectedGoalsHome',
          'expectedGoalsAway',
          'mostLikelyScore',
          'over25Pct',
          'bttsPct',
          'savedAtIso',
          'updatedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'id',
          'competition',
          'homeTeam',
          'awayTeam',
          'predictedHomePct',
          'predictedDrawPct',
          'predictedAwayPct',
          'expectedGoalsHome',
          'expectedGoalsAway',
          'mostLikelyScore',
          'over25Pct',
          'bttsPct',
          'liveScore',
          'actualScore',
          'snapshot',
          'savedAtIso',
          'updatedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.id)
        && data.id == analysisId
        && data.competition is string && data.competition.size() >= 1 && data.competition.size() <= 140
        && data.homeTeam is map
        && data.awayTeam is map
        && data.predictedHomePct is number && data.predictedHomePct >= 0 && data.predictedHomePct <= 100
        && data.predictedDrawPct is number && data.predictedDrawPct >= 0 && data.predictedDrawPct <= 100
        && data.predictedAwayPct is number && data.predictedAwayPct >= 0 && data.predictedAwayPct <= 100
        && data.expectedGoalsHome is number && data.expectedGoalsHome >= 0 && data.expectedGoalsHome <= 15
        && data.expectedGoalsAway is number && data.expectedGoalsAway >= 0 && data.expectedGoalsAway <= 15
        && data.mostLikelyScore is string && data.mostLikelyScore.size() >= 1 && data.mostLikelyScore.size() <= 24
        && data.over25Pct is number && data.over25Pct >= 0 && data.over25Pct <= 100
        && data.bttsPct is number && data.bttsPct >= 0 && data.bttsPct <= 100
        && (!('liveScore' in data) || data.liveScore is map)
        && (!('actualScore' in data) || data.actualScore is map)
        && (!('snapshot' in data) || data.snapshot is map)
        && data.savedAtIso is string && data.savedAtIso.size() >= 1 && data.savedAtIso.size() <= 64
        && data.updatedAtIso is string && data.updatedAtIso.size() >= 1 && data.updatedAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMultipleSlip(data, userId, multipleId) {
      return data.keys().hasAll([
          'ownerId',
          'id',
          'tipSignature',
          'competition',
          'leagueSlug',
          'dayFilter',
          'legs',
          'combinedProbabilityPct',
          'totalOdd',
          'stake',
          'potentialReturn',
          'status',
          'savedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'id',
          'tipSignature',
          'competition',
          'leagueSlug',
          'dayFilter',
          'legs',
          'combinedProbabilityPct',
          'totalOdd',
          'stake',
          'potentialReturn',
          'status',
          'source',
          'bookmaker',
          'notes',
          'resolvedAt',
          'savedAtIso',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.id)
        && data.id == multipleId
        && data.tipSignature is string && data.tipSignature.size() >= 1 && data.tipSignature.size() <= 500
        && data.competition is string && data.competition.size() >= 1 && data.competition.size() <= 180
        && data.leagueSlug is string && data.leagueSlug.size() >= 1 && data.leagueSlug.size() <= 80
        && data.dayFilter is string && data.dayFilter.size() <= 20 && data.dayFilter in ['all', 'today', 'tomorrow']
        && data.legs is list && data.legs.size() >= 1 && data.legs.size() <= 20 && data.legs[0] is map
        && data.combinedProbabilityPct is number && data.combinedProbabilityPct >= 0 && data.combinedProbabilityPct <= 100
        && data.totalOdd is number && data.totalOdd >= 1 && data.totalOdd <= 100000
        && data.stake is number && data.stake >= 0 && data.stake <= 10000000
        && data.potentialReturn is number && data.potentialReturn >= 0 && data.potentialReturn <= 100000000
        && data.status is string && data.status.size() <= 20 && data.status in ['pending', 'won', 'lost']
        && (!('source' in data) || (data.source is string && data.source.size() <= 20 && data.source in ['tip', 'image']))
        && (!('bookmaker' in data) || (data.bookmaker is string && data.bookmaker.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && data.savedAtIso is string && data.savedAtIso.size() >= 1 && data.savedAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppGlobalConfig(data) {
      return data.keys().hasAll([
          'appName',
          'announcementBanner',
          'maintenanceMode',
          'bettingMenuEnabled',
          'defaultChampionshipScope',
          'defaultMultipleCount',
          'defaultSearchWindow',
          'oddsMarginPct',
          'minTipProbabilityPct',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'appName',
          'announcementBanner',
          'maintenanceMode',
          'bettingMenuEnabled',
          'defaultChampionshipScope',
          'defaultMultipleCount',
          'defaultSearchWindow',
          'oddsMarginPct',
          'minTipProbabilityPct',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 80
        && data.announcementBanner is string && data.announcementBanner.size() <= 280
        && data.maintenanceMode is bool
        && data.bettingMenuEnabled is bool
        && data.defaultChampionshipScope is string && data.defaultChampionshipScope.size() <= 20 && data.defaultChampionshipScope in ['brasil', 'principais', 'todos']
        && data.defaultMultipleCount is int && data.defaultMultipleCount in [3, 4, 5, 10]
        && data.defaultSearchWindow is string && data.defaultSearchWindow.size() <= 20 && data.defaultSearchWindow in ['today', '48h', 'week']
        && data.oddsMarginPct is number && data.oddsMarginPct >= 0 && data.oddsMarginPct <= 20
        && data.minTipProbabilityPct is number && data.minTipProbabilityPct >= 50 && data.minTipProbabilityPct <= 90
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccountRecord(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'role',
          'status',
          'analysesCount',
          'multiplesCount',
          'lastLoginAt',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'photoURL',
          'role',
          'status',
          'analysesCount',
          'multiplesCount',
          'lastLoginAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role is string && data.role.size() <= 16 && data.role in ['user', 'admin']
        && data.status is string && data.status.size() <= 16 && data.status in ['active', 'blocked']
        && data.analysesCount is int && data.analysesCount >= 0 && data.analysesCount <= 100000
        && data.multiplesCount is int && data.multiplesCount >= 0 && data.multiplesCount <= 100000
        && data.lastLoginAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedByUid', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && isValidId(data.grantedByUid)
        && data.grantedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. Private User Profile (PII isolated)
    match /users/{userId}/private/{profileDocId} {
      allow get: if isValidId(userId) && isValidId(profileDocId) && profileDocId == 'profile' && isOwner(userId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(profileDocId)
        && profileDocId == 'profile'
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(profileDocId)
        && profileDocId == 'profile'
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(profileDocId) && profileDocId == 'profile' && isOwner(userId);
    }

    // 2. User Settings & Calibration Preferences
    match /users/{userId}/settings/{settingId} {
      allow get: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences' && isOwner(userId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(settingId)
        && settingId == 'preferences'
        && isOwner(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(settingId)
        && settingId == 'preferences'
        && isOwner(userId)
        && isValidUserPreferences(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'theme',
          'championshipScope',
          'updateMode',
          'activeModules',
          'recentFormWeight',
          'homeAdvantageMultiplier',
          'searchPreferences',
          'notifications',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences' && isOwner(userId);
    }

    // 3. Saved 1X2 Analyses
    match /users/{userId}/analyses/{analysisId} {
      allow get: if isValidId(userId) && isValidId(analysisId) && (isOwner(userId) || isAdmin());
      allow list: if (isOwner(userId) && existing().ownerId == request.auth.uid) || isAdmin();
      allow create: if isValidId(userId)
        && isValidId(analysisId)
        && isOwner(userId)
        && isValidPredictionAnalysis(incoming(), userId, analysisId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(analysisId)
        && isOwner(userId)
        && isValidPredictionAnalysis(incoming(), userId, analysisId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['liveScore', 'actualScore', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(analysisId) && isOwner(userId);
    }

    // 4. Saved Multiple Slips / Hot Tips / Imported Bet Slips
    match /users/{userId}/multiples/{multipleId} {
      allow get: if isValidId(userId) && isValidId(multipleId) && (isOwner(userId) || isAdmin());
      allow list: if (isOwner(userId) && existing().ownerId == request.auth.uid) || isAdmin();
      allow create: if isValidId(userId)
        && isValidId(multipleId)
        && isOwner(userId)
        && isValidMultipleSlip(incoming(), userId, multipleId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(multipleId)
        && isOwner(userId)
        && isValidMultipleSlip(incoming(), userId, multipleId)
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().tipSignature == existing().tipSignature
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['legs', 'status', 'resolvedAt', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isValidId(multipleId) && isOwner(userId);
    }

    // 5. Global App Configuration (Public non-PII get on 'global', Admin-only writes)
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'global';
      allow create: if isValidId(configId)
        && configId == 'global'
        && isAdmin()
        && isValidAppGlobalConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId)
        && configId == 'global'
        && isAdmin()
        && isValidAppGlobalConfig(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'appName',
          'announcementBanner',
          'maintenanceMode',
          'bettingMenuEnabled',
          'defaultChampionshipScope',
          'defaultMultipleCount',
          'defaultSearchWindow',
          'oddsMarginPct',
          'minTipProbabilityPct',
          'updatedByUid',
          'updatedByEmail',
          'updatedAt'
        ]);
      allow delete: if isValidId(configId) && configId == 'global' && isBootstrappedAdmin();
    }

    // 6. User Directory for Admin Panel (Owner can sync own stats; Admins can list & manage role/status)
    match /userAccounts/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && incoming().ownerId == request.auth.uid
        && isValidUserAccountRecord(incoming(), userId)
        && (incoming().role == 'user' || isBootstrappedAdmin())
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserAccountRecord(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'email',
              'photoURL',
              'analysesCount',
              'multiplesCount',
              'lastLoginAt',
              'updatedAt'
            ]))
          || (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'role',
              'status',
              'displayName',
              'updatedAt'
            ])
            && (!('email' in existing())
              || !isBootstrappedAdminEmailValue(existing().email)
              || (incoming().role == 'admin' && incoming().status == 'active')))
        );
      allow delete: if isValidId(userId)
        && isAdmin()
        && userId != request.auth.uid
        && (!('email' in existing()) || !isBootstrappedAdminEmailValue(existing().email));
    }

    // 7. Explicit Admin Grants
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId)
        && (isAdmin() || (isOwner(userId) && isBootstrappedAdmin()))
        && isValidAdminGrant(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isAdmin()
        && isValidAdminGrant(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedByUid', 'updatedAt']);
      allow delete: if isValidId(userId)
        && isAdmin()
        && userId != request.auth.uid
        && (!('email' in existing()) || !isBootstrappedAdminEmailValue(existing().email));
    }
  }
}
