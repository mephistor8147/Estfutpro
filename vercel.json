{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 30
    },
    "api/fixtures.ts": {
      "maxDuration": 20
    },
    "api/serie-a-multiple.ts": {
      "maxDuration": 25
    },
    "api/live-scores.ts": {
      "maxDuration": 25
    },
    "api/parse-bet-image.ts": {
      "maxDuration": 30
    },
    "api/super-combined-tip.ts": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
